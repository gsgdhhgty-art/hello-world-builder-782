# انسخ هذا الملف إلى .env.local ثم املأ القيم. لا ترفع .env أبدًا إلى Git.

# عنوان مشروع قاعدة البيانات (Supabase / Lovable Cloud)
VITE_SUPABASE_URL=
# المفتاح العام القابل للنشر (آمن في المتصفح)
VITE_SUPABASE_PUBLISHABLE_KEY=
# معرّف المشروع
VITE_SUPABASE_PROJECT_ID=

# متغيرات الخادم فقط (لا تُعرَّض للمتصفح)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# المفتاح الإداري: يُضاف في بيئة الاستضافة أو GitHub Secrets فقط
SUPABASE_SERVICE_ROLE_KEY=

# مفتاح AI Gateway للخادم فقط، مطلوب للمحلل الذكي
LOVABLE_API_KEY=
